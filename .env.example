# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Where the SQLite database lives (created on first run).
EDA_DB_PATH=var/edition_deals.db

# Address the web app uses to reach the API.
VITE_API_BASE=http://127.0.0.1:8000

# The Omega plugin doesn't read this file: Omega scrubs its agent's environment.
# Set its API address with Omega's edaApiBase setting instead (omega/README.md).

# The token Omega presents when it connects to the app's chat (/omega/ws).
# omega/use_web_chat.sh creates one in .env if it's missing.
EDA_OMEGA_WS_TOKEN=
