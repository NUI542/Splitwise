# Copy to .env and adjust. .env is git-ignored; never commit real values.

# Where the SQLite database lives (created on first run).
EDA_DB_PATH=var/edition_deals.db

# Address the web app uses to reach the API.
VITE_API_BASE=http://127.0.0.1:8000

# Used by the OmegaClaw skills in /omega to reach the API.
EDA_API_BASE=http://127.0.0.1:8000
